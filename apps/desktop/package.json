{
  "name": "irontion-desktop",
  "version": "0.2.1",
  "description": "Irontion desktop app (Linux, Windows, macOS) built with Tauri 2 + Svelte 5",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "app": "node scripts/with-clean-env.mjs tauri dev",
    "app:build": "node scripts/with-clean-env.mjs tauri build",
    "test": "vitest run"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "@lucide/svelte": "^1.52.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "~2.4.0",
    "echarts": "^6.1.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.3"
  },
  "private": true,
  "author": "dewakuneiei (https://github.com/dewakuneiei)",
  "repository": {
    "type": "git",
    "url": "https://github.com/dewakuneiei/irontion.git"
  },
  "homepage": "https://github.com/dewakuneiei/irontion"
}
